# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. With no .env at all the app boots into
# simulated mode: embedded Postgres (PGlite + pgvector), deterministic LLM
# stand-ins and simulated channels. Nothing external is contacted.
# ---------------------------------------------------------------------------

# Postgres. When unset, an in-process PGlite database is used and seeded on
# first request. Set this in production (Neon / Supabase / any Postgres with
# the pgvector extension available).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Optional: persist the local PGlite database between restarts.
# PGLITE_DATA_DIR=.pglite

# --- Intelligence layer -----------------------------------------------------
# Set either of these to switch the agents from deterministic simulation to
# real model calls through the Vercel AI Gateway.
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=

# Model routing. Cheap model handles extraction/classification, the strong
# model handles customer-facing generation and objection handling.
MODEL_FAST=anthropic/claude-haiku-4-5
MODEL_STRONG=anthropic/claude-opus-5
EMBED_DIM=256

# --- Channels ---------------------------------------------------------------
# Any channel without credentials falls back to the simulated adapter and is
# labelled as such in the UI. No outreach ever leaves the machine in that mode.
# GMAIL_ACCESS_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# LINKEDIN_SERVICE_URL=

# --- DronaHQ ----------------------------------------------------------------
# Delegates an agent's reasoning to a DronaHQ agent instead of a direct model
# call. In DronaHQ, add a Webhook trigger to the agent, set its response schema
# to match the agent contract in docs/dronahq.md, and paste the generated URL
# and that trigger's own api-key here. Per agent, so you can move them over
# one at a time — each DronaHQ agent has its own webhook URL AND its own key.
#
# DRONAHQ_AGENT_RESEARCH_URL=
# DRONAHQ_AGENT_RESEARCH_KEY=
# DRONAHQ_AGENT_QUALIFY_URL=
# DRONAHQ_AGENT_QUALIFY_KEY=
# DRONAHQ_AGENT_OUTREACH_URL=
# DRONAHQ_AGENT_OUTREACH_KEY=
# DRONAHQ_AGENT_PERSONALISE_URL=
# DRONAHQ_AGENT_PERSONALISE_KEY=
# DRONAHQ_AGENT_CONVERSE_URL=
# DRONAHQ_AGENT_CONVERSE_KEY=
# DRONAHQ_AGENT_VOICE_URL=
# DRONAHQ_AGENT_VOICE_KEY=
# DRONAHQ_AGENT_FOLLOWUP_URL=
# DRONAHQ_AGENT_FOLLOWUP_KEY=
#
# Optional fallback: one shared key used for any agent above that has no
# _KEY of its own set. Leave unset if every agent uses its own key.
# DRONAHQ_API_KEY=
